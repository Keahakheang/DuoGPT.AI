# Add these to Netlify -> Project configuration -> Environment variables (never to GitHub).
SERPAPI_KEY=your_private_serpapi_key
# Optional private shared passcode to prevent public visitors exhausting free search credits.
SEARCH_ACCESS_CODE=your_private_code
# Optional separate AI provider; live product search works WITHOUT HF_TOKEN.
HF_TOKEN=
CHAT_ACCESS_CODE=
HF_MODEL=
